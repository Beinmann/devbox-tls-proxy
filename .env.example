# Copy to .env (gitignored) and fill in.
# Cloudflare API token, scope Zone:DNS:Edit on rdrkolaq.de (see README)
CF_API_TOKEN=
# Container to proxy to (can also be given as the first argument of start.sh)
#TARGET=my-devbox
# Listen:target port list. Bare N means N->N; ranges expand.
#PORTS=443:80
#DOMAIN=localhost.rdrkolaq.de
# Let's Encrypt staging while testing (certs not browser-trusted):
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# original = pass Host through unchanged (default); target = Host: <TARGET>:<port>
#HOST_HEADER=original
# Docker command, e.g. "sudo docker"
#DOCKER=docker
